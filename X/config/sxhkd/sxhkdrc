# --> Volume Controls

XF86AudioRaiseVolume
  pactl set-sink-volume @DEFAULT_SINK@ +5%

XF86AudioLowerVolume
  pactl set-sink-volume @DEFAULT_SINK@ -5%

XF86AudioMute
  pactl set-sink-mute @DEFAULT_SINK@ toggle

XF86AudioMicMute
  pactl set-source-mute @DEFAULT_SOURCE@ toggle

XF86MonBrightnessUp
  brightnessctl -d 'amdgpu_bl1' s +10%

XF86MonBrightnessDown
  brightnessctl -d 'amdgpu_bl1' s 10%-


# --> Power Management

super + shift + alt + S
  systemctl suspend
  
super + shift + alt + R
  shutdown -r now

super + shift + alt + K
  mpv --volume-gain=10 $HOME/media/vistashutdown.mp3; shutdown -P now


# --> Screen Capture

super + shift + {O,R}
  $HOME/.config/scripts/screenshot {-oc,-rc}

super + ctrl + {o,r}
  $HOME/.config/scripts/screenshot {-os,-rs}


